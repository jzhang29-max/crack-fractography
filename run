#!/usr/bin/env bash
# Start the fractography analysis app. Nothing to configure.
#
#   ./run
#
set -euo pipefail
cd "$(dirname "$0")"

PORT="${PORT:-8810}"
VENV="${VENV:-.venv}"

# Is there a WORKING venv here? Asked of the interpreter, not of a file. bin/activate exists
# after a move and lies about it -- that is what broke all three sibling repos on 2026-09-24,
# where sourcing a stale activate silently handed the app conda's scikit-learn instead of the
# venv's and only the detector died.
venv_is_usable() {
  [ -x "$VENV/bin/python3" ] || return 1
  "$VENV/bin/python3" - "$VENV" <<'PYCHECK' 2>/dev/null
import os, sys
sys.exit(0 if (sys.prefix != sys.base_prefix
               and os.path.realpath(sys.prefix) == os.path.realpath(sys.argv[1])) else 1)
PYCHECK
}

if ! venv_is_usable; then
  if [ -e "$VENV" ]; then
    echo "==> $VENV does not work from this directory. Rebuilding it."
    rm -rf "$VENV"
  fi
  echo "==> creating virtualenv in $VENV"
  if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)'; then
    echo "  This app needs Python 3.12 or newer. Found $(python3 -V) at $(command -v python3)."
    exit 1
  fi
  python3 -m venv "$VENV" || { rm -rf "$VENV"; echo "  venv creation failed"; exit 1; }
fi

# Never `source bin/activate` and never a bare `python3`: the interpreter is named, so no PATH
# entry can substitute a different one.
PY="$PWD/$VENV/bin/python3"

STAMP="$VENV/.req-stamp"
if [ ! -f "$STAMP" ] || ! cmp -s requirements.txt "$STAMP"; then
  echo "==> installing dependencies"
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r requirements.txt
  cp requirements.txt "$STAMP"
fi

# The data links are how a CHECKOUT finds the sibling repos. They are no longer required:
# the app measures masks you give it with no repo at all, and says so on the page. So a
# dangling link is a warning about what will be unavailable, not a reason to refuse to start.
missing=""
for d in sem txm txm_export; do
  [ -e "data/$d" ] || missing="$missing $d"
done
if [ -n "$missing" ]; then
  echo "==> not linked:$missing"
  echo "    The reference corpus and .tif segmentation need them. Uploaded masks do not."
  echo "    Link with:  ln -s ../../<repo> data/<name>       or set the path in Setup."
fi

if [ ! -f analysis/out/frames.json ] && [ -e "data/sem" ]; then
  echo "==> no measurements yet. Building them (this takes a few minutes):"
  "$PY" analysis/batch.py --arm all
fi

echo "==> http://127.0.0.1:$PORT"
exec "$PY" -m uvicorn app.server:app --host 127.0.0.1 --port "$PORT" --app-dir .
