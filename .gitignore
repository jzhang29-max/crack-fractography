.venv/
__pycache__/
*.pyc
# Relative symlinks to the sibling repos. Local wiring, not repo content -- and pointing them
# at one machine's layout is what this project spent 2026-09-24 repairing.
data/sem
data/txm
data/txm_export
data/txm_export_machine
# Derived measurements. Regenerable with analysis/batch.py, and large.
analysis/out/
# PyInstaller output. The .app is 152 MB of rebuilt dependencies -- a release artifact,
# never repo content.
build/
dist/
# The vendored copy is generated by packaging/vendor.py from the SEM repo, but it IS
# tracked: a clone with no sibling repo still has to be able to build and to measure.

# CI debug screenshot, written by packaging/ui_check.py on failure.
ui_check.png
_ui_server.log
_smoke.log

# smoke_check.py's scratch: a throwaway data dir and log it writes beside the repo
# when the release gate runs the packaged binary by hand.
_smoke_data/
_smoke.log

# The publishable dataset folder built by tools/build_release.py, and the Zenodo
# download cache beside it. Several gigabytes of image data plus other people's
# redistributed collections -- the BUILDER is the reproducible artifact, never the
# bytes it assembles.
release/

# Scratch caches written by the classifier tuning and leave-one-out runners.
# Regenerable, and large: per-frame label maps for every scorable SEM frame.
docs/figures/_tunecache/
docs/figures/_lofo_folds/
paper/figures/dz_fold_*.joblib
.DS_Store
